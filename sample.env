# MongoDB Connection
MLAB_URI

# Slack Integration
# Preferred bot token for ordinary API calls.
SLACK_BOT_TOKEN
# Optional user/admin token for privileged Slack API calls.
SLACK_ADMIN_TOKEN
# Enables signup Slack invitations when set to true.
SLACK_INVITES_ENABLED
# Optional channel name or ID. When present, new signups are invited as
# single-channel guests and promoted after membership activation.
CHANNEL_NEW_SIGNUPS

# Mailer Credentials
GMAIL_PASSWORD
GMAIL_USERNAME

# Google Integration
GOOGLE_ID
GOOGLE_SECRET
GOOGLE_TOKEN
GOOGLE_CUSTOMER_ID=my_customer
GOOGLE_RESERVATIONS_CALENDAR_ID
# Optional. When nonblank, /reservations/agenda(.json) requires ?token=...
RESERVATION_TOKEN

# Public wiki base URL used by the portal and default workshop/tool links
WIKI_URL=https://wiki.manchestermakerspace.org

# Paypal Integration
PAYPAL_CLIENT_ID
PAYPAL_SECRET
BT_ENV
BT_PRIVATE_KEY
BT_PUBLIC_KEY
BT_MERCHANT_ID

# Manchester Makerspace Documents and upload locations
CODE_CONDUCT_ID
CODE_CONDUCT_FOLDER
CONTRACT_ID
MEMBER_CONTRACT_FOLDER
RENTAL_AGREEMENT_ID
RENTAL_AGREEMENT_FOLDER

RESOURCES_FOLDER # Google drive folder for shared member resources
GOOGLE_TRANSFER_SHARE # Google drive folder where members receive writer access
GDRIVE_INVITES_ENABLED # Enables Google Drive member permissions when true
SIGNATURES_FOLDER # Testing folder for signatures
BACKUP_FOLDER # Where db backups are stored

# PROD
SECRET_KEY_BASE

# Cloudflare Turnstile
TURNSTILE_SITE_KEY
TURNSTILE_SECRET
