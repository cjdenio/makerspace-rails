<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Manchester Makerspace — Volunteer Leaderboard</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0d1117;
      color: #e6edf3;
      min-height: 100vh;
      padding: 2rem 1rem;
    }

    .container {
      max-width: 700px;
      margin: 0 auto;
    }

    .header {
      text-align: center;
      margin-bottom: 2rem;
    }

    .header h1 {
      font-size: 2rem;
      font-weight: 700;
      color: #58a6ff;
      margin-bottom: 0.25rem;
    }

    .header p {
      color: #8b949e;
      font-size: 0.9rem;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      background: #161b22;
      border-radius: 8px;
      overflow: hidden;
    }

    thead tr {
      background: #21262d;
    }

    thead th {
      padding: 0.75rem 1rem;
      text-align: left;
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #8b949e;
    }

    thead th:last-child { text-align: right; }

    tbody tr {
      border-top: 1px solid #21262d;
      transition: background 0.15s;
    }

    tbody tr:hover { background: #1c2128; }

    tbody td {
      padding: 0.85rem 1rem;
      font-size: 0.95rem;
    }

    tbody td:last-child {
      text-align: right;
      font-weight: 600;
      color: #58a6ff;
    }

    .rank {
      color: #8b949e;
      font-size: 0.85rem;
      width: 2.5rem;
    }

    .rank-1 { color: #ffd700; font-weight: 700; }
    .rank-2 { color: #c0c0c0; font-weight: 700; }
    .rank-3 { color: #cd7f32; font-weight: 700; }

    .empty {
      text-align: center;
      padding: 3rem;
      color: #8b949e;
    }

    .footer {
      text-align: center;
      margin-top: 1.5rem;
      color: #8b949e;
      font-size: 0.8rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Volunteer Leaderboard</h1>
      <p>Manchester Makerspace — Lifetime Credits</p>
    </div>

    <table>
      <thead>
        <tr>
          <th class="rank">#</th>
          <th>Member</th>
          <th>Lifetime Credits</th>
        </tr>
      </thead>
      <tbody>
        <% if @entries.empty? %>
          <tr>
            <td colspan="3" class="empty">No volunteer credits recorded yet.</td>
          </tr>
        <% else %>
          <% @entries.each do |entry| %>
            <tr>
              <td class="rank rank-<%= entry[:rank] %>"><%= entry[:rank] %></td>
              <td><%= entry[:name] %></td>
              <td><%= entry[:lifetime_credits] %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>

    <div class="footer">
      Updated <%= Time.now.strftime('%B %d, %Y at %I:%M %p %Z') %>
    </div>
  </div>
</body>
</html>
