{
  "_metadata": {
    "major_version": 2,
    "minor_version": 1
  },
  "display_information": {
    "name": "Makerspace Member Portal",
    "description": "Member Portal notifications, commands, channel access, and reservation canvases.",
    "background_color": "#1f4e79"
  },
  "features": {
    "bot_user": {
      "display_name": "MemberPortalBot",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/checkout",
        "url": "https://YOUR_MEMBER_PORTAL_HOST/slack/commands/checkout",
        "description": "Request and manage tool safety checkouts",
        "should_escape": false
      },
      {
        "command": "/reserve",
        "url": "https://YOUR_MEMBER_PORTAL_HOST/slack/commands/reserve",
        "description": "Create and manage reservations",
        "should_escape": false
      },
      {
        "command": "/volunteer",
        "url": "https://YOUR_MEMBER_PORTAL_HOST/slack/commands/volunteer",
        "description": "Browse and claim volunteer tasks",
        "should_escape": false
      },
      {
        "command": "/fix",
        "url": "https://YOUR_MEMBER_PORTAL_HOST/slack/commands/fix",
        "description": "Report and manage tool repair tickets",
        "usage_hint": "[new|show|mine|assigned|queue|public|#ticket-number]",
        "should_escape": false
      },
      {
        "command": "/fix-tickets",
        "url": "https://YOUR_MEMBER_PORTAL_HOST/slack/commands/fix",
        "description": "Report problems or show open repair tickets",
        "usage_hint": "[new|show|mine|assigned|queue|public|#ticket-number]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "canvases:read",
        "canvases:write",
        "channels:join",
        "channels:manage",
        "channels:read",
        "channels:write.invites",
        "chat:write",
        "chat:write.customize",
        "chat:write.public",
        "commands",
        "groups:read",
        "groups:write",
        "groups:write.invites",
        "im:read",
        "mpim:read",
        "pins:write",
        "team:read",
        "users.profile:read",
        "users:read",
        "users:read.email",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "im:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR_MEMBER_PORTAL_HOST/slack/events",
      "bot_events": [
        "team_join",
        "user_change"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://YOUR_MEMBER_PORTAL_HOST/slack/interactions"
    }
  }
}
